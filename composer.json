{
    "name": "dirthara/database",
    "description": "Database connection for the Dirthara framework",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-pdo_mysql": "To connect with the MySQL driver",
        "ext-pdo_pgsql": "To connect with the PostgreSQL driver",
        "ext-pdo_sqlite": "To connect with the SQLite driver",
        "ext-pdo_sqlsrv": "To connect with the SQL Server driver"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dirthara\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dirthara\\Database\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dirthara"
        }
    ],
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "mago": "sh scripts/mago.sh",
        "fmt": "mago fmt",
        "fmt-check": "mago fmt --check",
        "lint": "mago lint",
        "lint-fix": "mago lint --fix --potentially-unsafe",
        "analyze": "mago analyze",
        "guard": "mago guard",
        "test": "phpunit",
        "cs": [
            "@fmt",
            "@lint"
        ]
    }
}
